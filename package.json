{
  "name": "mcp-hub",
  "version": "0.5.0",
  "private": true,
  "description": "Local MCP Hub for VS Code and compatible MCP clients",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @mcp-hub/hub dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "cli": "pnpm --filter @mcp-hub/cli dev",
    "package:extension": "pnpm --filter @mcp-hub/vscode-bridge package"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
